{
  "name": "translation-preview",
  "displayName": "Translation Preview",
  "description": "Show JSON translations for tr() keys in Dart files.",
  "version": "0.0.6",
  "publisher": "telefy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:dart"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "translationPreview.selectConfig",
        "title": "Translation Preview: Select Config"
      },
      {
        "command": "translationPreview.reload",
        "title": "Translation Preview: Reload"
      }
    ],
    "configuration": {
      "title": "Translation Preview",
      "properties": {
        "translationPreview.configFiles": {
          "type": "array",
          "items": {"type": "string"},
          "default": ["assets/translations/ru.json"],
          "description": "Translation JSON files, relative to the workspace root. The first existing file is used."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
